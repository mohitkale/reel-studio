# Reel Studio environment variables.
# Copy to .env.local (git-ignored) or enter keys in the in-app Settings screen.
# Never commit real keys.
#
# Licensing: Reel Studio code is MIT. HyperFrames is the only video engine
# (Apache-2.0). GSAP has its own standard license.
# Optional providers below have their own terms. See docs/LICENSING.md.

# Cartesia (https://docs.cartesia.ai) — vendor commercial terms apply
CARTESIA_API_KEY=

# ElevenLabs (https://elevenlabs.io/docs) — vendor commercial terms apply.
# Free/Starter plans work; the app falls back from wav_44100 to wav_24000 when needed.
ELEVENLABS_API_KEY=

# Google Gemini (optional AI scene generation) — Google AI terms apply
GEMINI_API_KEY=

# OpenAI (optional AI scene generation) — OpenAI terms apply
OPENAI_API_KEY=

# Unsplash (optional stock backgrounds for AI scenes — free Demo tier).
# Create an app at https://unsplash.com/oauth/applications and use its Access Key.
# Photos are under the Unsplash License; follow API attribution guidelines.
UNSPLASH_ACCESS_KEY=

# Pexels (optional stock photos and videos).
# Create a key at https://www.pexels.com/api/ and follow Pexels attribution rules.
# Search responses are cached; selected render media is validated and stored locally.
PEXELS_API_KEY=

# Pixabay (optional stock images and videos).
# Create a key at https://pixabay.com/api/docs/. API responses must be cached for 24 hours.
# Remote image URLs are previews only; selected media is validated and stored locally.
PIXABAY_API_KEY=

# Jamendo (optional expanded music library — 600k+ Creative Commons tracks).
# Get a free Client ID at https://devportal.jamendo.com.
# Each track has its own CC license — check attribution before commercial use.
JAMENDO_CLIENT_ID=

# MCP server access token. Do NOT set this by hand — generate/rotate it in
# Settings → AI tools / MCP, then copy it into your AI tool's MCP config.
MCP_API_TOKEN=

# Optional: require a bearer token for every API/media request, even browser
# same-origin requests on localhost. There is no browser login in this mode;
# web-only settings and approvals remain unavailable to bearer automation.
# REEL_STRICT_AUTH=1

# Server listener defaults to 127.0.0.1. Docker explicitly uses 0.0.0.0 inside
# its container while publishing on host loopback only. CLI -H/--hostname wins.
# REEL_BIND_HOST=127.0.0.1

# Optional comma-separated extra Host names (no URL schemes or wildcards).
# This is a DNS-rebinding guard, not client authentication. Shared-network
# deployments need an authentication layer and REEL_STRICT_AUTH=1.
# Reverse proxies must preserve an allowed raw Host; forwarded Host is ignored.
# REEL_ALLOWED_HOSTS=studio.example.com

# Optional: override render concurrency (integer >= 1).
# Leave empty to use adaptive defaults based on your machine.
REMOTION_RENDER_CONCURRENCY=

# Quick Produce is an off-by-default request option, not an environment switch.
# Its no-key path uses deterministic planning plus server-side Kokoro. Kokoro's
# Apache-2.0 weights may be fetched and cached by kokoro-js on first use.
# Ollama and LM Studio endpoints/models are configured in Settings and stored in
# the git-ignored .data/local-ai-config.json, not in this file.

# Optional ffmpeg executable override. ffmpeg is used for MP4 rendering and
# production MP3 podcast exports; WAV generation remains available without it.
FFMPEG_BIN=

# Optional: skip render smoke test in restricted CI environments.
# SKIP_RENDER_SMOKE=1
SKIP_RENDER_SMOKE=

# Optional local caption alignment with whisper.cpp. Install the CLI and a model
# yourself, then point Reel Studio at both files. Core caption editing/import works
# without these settings.
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=

# Local SQLite database for Prisma (resolved relative to prisma/)
DATABASE_URL="file:./dev.db"

# VoiceForge — self-hosted voice cloning (https://github.com/mohitkale/voiceforge).
# Prefer 127.0.0.1 over localhost (avoids IPv6 ::1 mismatches on macOS).
# If Reel Studio runs in Docker and VoiceForge is on the host, use:
#   VOICEFORGE_SERVICE_URL=http://host.docker.internal:8089
# Engine model licenses vary (e.g. XTTS-v2 CPML is non-commercial) — see docs/LICENSING.md.
# First CPU synth per scene can take 1–10+ minutes; Reel Studio waits up to 10 min per scene.
VOICEFORGE_SERVICE_URL=http://127.0.0.1:8089
# Optional bearer token when VoiceForge is not open localhost (matches VOICEFORGE_API_TOKEN on the service).
VOICEFORGE_API_TOKEN=
