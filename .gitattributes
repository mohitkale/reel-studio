# Files that execute inside the Linux Docker container must keep LF line
# endings on checkout, even on Windows where core.autocrlf=true would otherwise
# rewrite them to CRLF (which breaks shell scripts: `set -e\r` -> error).
*.sh           text eol=lf
docker/**      text eol=lf
Dockerfile     text eol=lf
docker-compose.yml text eol=lf

# Catalog manifests hash bytes. Keep all checked-in text deterministic across
# Windows/macOS/Linux, while Git's binary detection leaves media unchanged.
* text=auto eol=lf
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.gif -text
*.mp4 -text
*.mov -text
*.wav -text
*.mp3 -text
*.woff -text
*.woff2 -text
*.ttf -text
*.otf -text
