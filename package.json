{
  "name": "reel-studio",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/supervise.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/supervise.mjs start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "mcp": "tsx mcp/src/index.ts",
    "production:worker": "tsx scripts/production-worker.ts",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:inventory": "node scripts/dependency-inventory.mjs",
    "prepare:hooks": "git config core.hooksPath .githooks",
    "postinstall": "prisma generate",
    "setup": "node scripts/setup.mjs",
    "demo": "node scripts/demo.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "sample:export": "tsx scripts/export-sample.ts",
    "release:check": "tsx scripts/release-check.ts",
    "release:matrix": "tsx scripts/release-render-matrix.ts",
    "seed:gallery": "node scripts/seed-gallery-assets.mjs",
    "seed:assets": "tsx scripts/seed-assets.ts",
    "seed:demo-brandkit": "tsx scripts/seed-demo-brandkit.ts",
    "seed:demo-project": "tsx scripts/seed-demo-project.ts",
    "seed:demo-podcast": "tsx scripts/seed-demo-podcast.ts",
    "export:demo-assets": "tsx scripts/export-demo-assets.ts",
    "gen:music": "node scripts/generate-music.mjs",
    "sync:hf-catalog": "tsx scripts/sync-hf-catalog.ts",
    "sync:hf-runtime": "node scripts/sync-render-runtime.mjs",
    "test:motion-library": "node --import tsx scripts/verify-motion-library.mjs",
    "test:motion-spec": "node --import tsx scripts/verify-motion-spec.mjs",
    "test:export-fidelity": "node --import tsx scripts/verify-export-fidelity.mjs",
    "gen:sfx": "node scripts/generate-sfx.mjs",
    "test:unit": "vitest run --exclude src/lib/render-smoke.test.ts",
    "test:render": "tsx scripts/render-regression.ts",
    "test:stock-video-render": "tsx scripts/stock-video-render-regression.ts",
    "test:render:product-launch": "tsx scripts/render-regression.ts --product-launch",
    "test:render:editorial": "tsx scripts/render-regression.ts --preset=editorial-explainer",
    "test:render:creator-punch": "tsx scripts/render-regression.ts --preset=creator-punch",
    "test:render:data-story": "tsx scripts/render-regression.ts --preset=data-story",
    "test:render:developer-demo": "tsx scripts/render-regression.ts --preset=developer-demo",
    "test:render:cinematic-brand": "tsx scripts/render-regression.ts --preset=cinematic-brand",
    "test:podcast-audio": "tsx scripts/verify-podcast-audio.ts",
    "test:podcast-audiogram": "tsx scripts/render-podcast-audiogram.ts",
    "db:migrate": "node scripts/migrate-database.mjs",
    "test:production-worker": "node --import tsx scripts/verify-production-worker.ts",
    "test:video-sections": "node --import tsx scripts/verify-video-sections.ts",
    "benchmark:long-videos": "node --import tsx scripts/benchmark-long-videos.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hyperframes/producer": "0.8.111",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "kokoro-js": "1.2.1",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "lottie-web": "5.13.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "hyperframes": "0.8.110",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
