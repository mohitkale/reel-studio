{
  "name": "reel-studio",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "studio": "remotion studio src/remotion/index.ts",
    "mcp": "tsx mcp/src/index.ts",
    "security:scan": "node scripts/scan-secrets.mjs",
    "prepare:hooks": "git config core.hooksPath .githooks",
    "postinstall": "prisma generate",
    "setup": "node scripts/setup.mjs",
    "demo": "node scripts/demo.mjs",
    "seed:assets": "tsx scripts/seed-assets.ts",
    "seed:demo-brandkit": "tsx scripts/seed-demo-brandkit.ts",
    "seed:demo-project": "tsx scripts/seed-demo-project.ts",
    "seed:demo-podcast": "tsx scripts/seed-demo-podcast.ts",
    "export:demo-assets": "tsx scripts/export-demo-assets.ts",
    "gen:music": "node scripts/generate-music.mjs",
    "embed:hf-catalog": "node scripts/embed-hf-catalog.mjs",
    "import:hf-catalog": "tsx scripts/import-hf-catalog.ts",
    "gen:sfx": "node scripts/generate-sfx.mjs",
    "test:unit": "vitest run --exclude src/lib/render-smoke.test.ts",
    "test:render": "tsx scripts/render-regression.ts",
    "test:render:product-launch": "tsx scripts/render-regression.ts --product-launch",
    "db:migrate": "node scripts/migrate-database.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hyperframes/producer": "0.8.33",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@remotion/bundler": "4.0.523",
    "@remotion/cli": "4.0.523",
    "@remotion/google-fonts": "4.0.523",
    "@remotion/lottie": "4.0.523",
    "@remotion/player": "4.0.523",
    "@remotion/renderer": "4.0.523",
    "@remotion/three": "4.0.523",
    "@remotion/transitions": "4.0.523",
    "@tanstack/react-query": "5.102.8",
    "@types/three": "0.185.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.25.12",
    "gsap": "3.14.2",
    "kokoro-js": "1.2.1",
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.523",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "0.186.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
